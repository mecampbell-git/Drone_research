<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='my_x500_see3cam_down'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>my_x500</uri>
    </include>
    <!--
      Under the body, centred (base_link is at z .24 in the model frame; the body's underside
      is at ~.222). Pitch +90 deg turns the camera's +X optical axis to point down, with the
      top of the image towards the nose. Update the pose once the real mount is built.
    -->
    <include merge='true'>
      <uri>model://see3cam_24cug</uri>
      <pose>.12 0 .20 0 1.57 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
