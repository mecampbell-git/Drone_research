<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_missions</name>
  <version>0.0.1</version>
  <description>Waypoint missions as PX4 ROS 2 custom modes (px4-ros2-interface-lib)</description>
  <maintainer email="m.e.campbell82@gmail.com">Martin Campbell</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>

  <build_depend>eigen</build_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>px4_ros2_cpp</depend>
  <!-- Mission CSVs are shared with px4_offboard and installed by it -->
  <exec_depend>px4_offboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
